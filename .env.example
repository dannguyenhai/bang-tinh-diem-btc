# Công khai — nhúng vào bundle trình duyệt, chỉ dùng để nghe bảng nhịp realtime.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_GAME_ID=default

# BÍ MẬT — chỉ tồn tại phía server. Không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SESSION_SECRET=<chuỗi ngẫu nhiên, ví dụ: openssl rand -base64 32>
